# Rendered by the official nginx image entrypoint (envsubst) -> /etc/nginx/conf.d/default.conf
# Resolve the backend at request time (not at startup) so nginx starts even if the API is not up yet.
# NGINX_LOCAL_RESOLVERS is filled in by the image entrypoint from /etc/resolv.conf.
resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  location / {
    try_files $uri /index.html;
  }

  # API proxy for docker compose / port-forward use. In Kubernetes the Ingress routes /api directly to the backend.
  location /api/ {
    set $backend_upstream ${BACKEND_URL};
    proxy_pass $backend_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }

  location = /nginx-health {
    access_log off;
    return 200 "ok\n";
  }
}
